layout {

    focus-ring {
        active-color   "#eda15f"
        inactive-color "#291e14"
        urgent-color   "#e7842d"
    }

    border {
        active-color   "#eda15f"
        inactive-color "#291e14"
        urgent-color   "#e7842d"
    }

    shadow {
        color "#291e1470"
    }

    tab-indicator {
        active-color   "#eda15f"
        inactive-color "#954804"
        urgent-color   "#e7842d"
    }

    insert-hint {
        color "#eda15f80"
    }
}

recent-windows {
    highlight {
        active-color "#eda15f"
        urgent-color "#e7842d"
    }
}
