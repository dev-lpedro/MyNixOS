layout {

    focus-ring {
        active-color   "#6261ea"
        inactive-color "#070736"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6261ea"
        inactive-color "#070736"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#07073670"
    }

    tab-indicator {
        active-color   "#6261ea"
        inactive-color "#070692"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6261ea80"
    }
}

recent-windows {
    highlight {
        active-color "#6261ea"
        urgent-color "#fd4663"
    }
}
