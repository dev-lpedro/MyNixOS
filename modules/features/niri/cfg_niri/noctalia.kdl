layout {

    focus-ring {
        active-color   "#67e4d9"
        inactive-color "#1a2323"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67e4d9"
        inactive-color "#1a2323"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a232370"
    }

    tab-indicator {
        active-color   "#67e4d9"
        inactive-color "#0c8d82"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67e4d980"
    }
}

recent-windows {
    highlight {
        active-color "#67e4d9"
        urgent-color "#fd4663"
    }
}
